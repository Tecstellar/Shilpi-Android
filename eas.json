{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000/api/v1",
        "EXPO_PUBLIC_WS_URL": "http://10.0.2.2:4000"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.shilpiapp.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://api.shilpiapp.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
